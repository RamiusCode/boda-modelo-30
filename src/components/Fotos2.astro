---
// Fotos2.astro
// Encuadre por foto: las apaisadas se corren para no cortar las caras
const fotos = [
    { src: "/imagenes/foto7.jpg", pos: "center" },
    { src: "/imagenes/foto5.jpg", pos: "center" },
    { src: "/imagenes/foto4.jpg", pos: "center" },
    { src: "/imagenes/foto2.jpg", pos: "30% center" },
    { src: "/imagenes/foto1.jpg", pos: "center" },
];
---

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 📸 SECCIÓN: NOSOTROS - CARRUSEL + GALERÍA                   -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full pt-10 pb-14 px-5 overflow-hidden" id="seccion-fotos2">

    <!-- TÍTULO -->
    <h2
        class="font-romantic-lovely text-[#d9c07a] text-5xl sm:text-6xl text-center mb-8"
        id="titulo-nosotros"
    >
        Nosotros
    </h2>

    <!-- CARRUSEL PRINCIPAL (auto-rotativo) -->
    <div class="relative w-full max-w-sm mx-auto mb-4" id="carrusel-nosotros">
        <div class="relative w-full aspect-[3/4] rounded-xl overflow-hidden shadow-2xl border border-[#C2A96B]/40">
            {
                fotos.map((foto, i) => (
                    <img
                        src={foto.src}
                        alt={`Foto ${i + 1}`}
                        class="carrusel-img absolute inset-0 w-full h-full object-cover transition-opacity duration-1000"
                        style={`opacity: ${i === 0 ? 1 : 0}; object-position: ${foto.pos};`}
                        data-index={i}
                    />
                ))
            }
        </div>
    </div>

    <!-- GALERÍA (3 por fila, última fila centrada, miniaturas chuecas superpuestas) -->
    <div
        class="relative z-20 flex flex-wrap justify-center gap-x-2 gap-y-3 max-w-md mx-auto -mt-[15%]"
        id="galeria-scattered"
    >
        {
            fotos.map((foto, i) => {
                const rotaciones = [-6, 4, -3, 5, -5, 3, -4, 6, -2, 4, -6];
                const rot = rotaciones[i % rotaciones.length];
                return (
                    <div
                        class="galeria-item w-[calc((100%-1rem)/3)] rounded-md overflow-hidden shadow-xl border-2 border-[#f3ead9]/80"
                        style={`transform: rotate(${rot}deg);`}
                        data-rot={rot}
                        data-gindex={i}
                    >
                        <img
                            src={foto.src}
                            alt={`Galería ${i + 1}`}
                            style={`object-position: ${foto.pos};`}
                            class="w-full aspect-[3/4] object-cover"
                            loading="lazy"
                        />
                    </div>
                );
            })
        }
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 SCRIPT: CARRUSEL + ANIMACIONES GSAP                      -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        // ═══ CARRUSEL AUTO-ROTATIVO ═══
        const imgs = Array.from(
            document.querySelectorAll<HTMLImageElement>(".carrusel-img"),
        );
        let actual = 0;

        function mostrar(indice: number) {
            imgs.forEach((img, i) => {
                img.style.opacity = i === indice ? "1" : "0";
            });
        }

        if (imgs.length > 0) {
            setInterval(() => {
                actual = (actual + 1) % imgs.length;
                mostrar(actual);
            }, 2800);
        }

        // ═══ TÍTULO ═══
        gsap.fromTo(
            "#titulo-nosotros",
            { opacity: 0, y: -20 },
            {
                opacity: 1,
                y: 0,
                duration: 1,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#seccion-fotos2",
                    start: "top 85%",
                    toggleActions: "play none none reset",
                },
            },
        );

        // ═══ CARRUSEL ENTRADA ═══
        gsap.fromTo(
            "#carrusel-nosotros",
            { opacity: 0, scale: 0.9 },
            {
                opacity: 1,
                scale: 1,
                duration: 1.2,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: "#carrusel-nosotros",
                    start: "top 85%",
                    toggleActions: "play none none reset",
                },
            },
        );

        // ═══ GALERÍA: rotación ligada al scroll ═══
        // Entra rotada → se alinea (0°) en el centro → rota en sentido contrario al salir
        const items = Array.from(
            document.querySelectorAll<HTMLElement>(".galeria-item"),
        );
        items.forEach((item) => {
            const rot = Number(item.dataset.rot ?? 0);
            gsap.fromTo(
                item,
                { rotation: rot },
                {
                    rotation: -rot,
                    ease: "none",
                    scrollTrigger: {
                        trigger: item,
                        start: "top bottom",
                        end: "bottom top",
                        scrub: 1,
                    },
                },
            );
        });
    });
</script>
