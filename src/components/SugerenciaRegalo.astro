---
// SugerenciaRegalo.astro
// Datos de muestra del QR (modelo para clientes)
const qr = {
    imagen: "/imagenes/qr.png",
    banco: "Banco Unión",
    titular: "Alain y Marisabel",
};
---

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎁 SECCIÓN: SUGERENCIA DE REGALO                            -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full pt-10 pb-14 px-6 overflow-hidden" id="seccion-regalos">

    <!-- SEPARADORES DORADOS -->
    <div class="absolute top-0 left-6 right-6 h-px bg-gradient-to-r from-transparent via-[#C2A96B]/60 to-transparent"></div>
    <div class="absolute bottom-0 left-6 right-6 h-px bg-gradient-to-r from-transparent via-[#C2A96B]/60 to-transparent"></div>

    <!-- DECORACIÓN FLORAL COSTADITO2 (izquierda) -->
    <img
        src="/imagenes/costadito2.png"
        alt="Decoración floral"
        class="sr-flor absolute -left-8 top-[62%] w-20 sm:w-24 z-20 pointer-events-none select-none"
        id="costadito2-regalos"
        data-entrada="izq"
    />

    <!-- CONTENIDO CENTRADO -->
    <div class="relative z-10 flex flex-col items-center text-center max-w-xs mx-auto">

        <!-- PLUMA SUPERIOR -->
        <div class="mb-5" id="pluma-regalos" data-entrada="arriba">
            <img
                src="/imagenes/pluma.png"
                alt="Pluma decorativa"
                class="sr-pluma w-20 sm:w-24 object-contain"
            />
        </div>

        <!-- IMAGEN REGALO dentro de un aro dorado -->
        <div class="sr-icono mb-6" id="img-regalo" data-entrada="giro">
            <svg viewBox="0 0 100 100" fill="none" aria-hidden="true">
                <circle class="sr-aro" pathLength="1" cx="50" cy="50" r="47"></circle>
            </svg>
            <img
                src="/imagenes/regalo.png"
                alt="Regalo"
                class="w-12 sm:w-14 object-contain relative"
                style="filter: brightness(0) saturate(100%) invert(72%) sepia(40%) saturate(400%) hue-rotate(5deg) brightness(95%);"
            />
        </div>

        <!-- TEXTO PRINCIPAL -->
        <p
            class="font-mollen-light text-[#f3ead9]/90 text-base sm:text-lg leading-relaxed mb-8"
            id="texto-regalo"
            data-entrada="desenfoque"
        >
            Tu presencia es nuestro mejor regalo, pero si deseas obsequiarnos algo, ponemos a tu disposición nuestra mesa de regalo en:
        </p>

        <!-- ═══ TARJETA: QR ═══ -->
        <div class="sr-tarjeta w-full" id="tarjeta-qr" data-entrada="der">
            <span class="sr-etiqueta font-jane-light">Regalo con QR</span>

            <p class="font-mollen-light text-[#f3ead9]/90 text-base leading-relaxed mb-5">
                Si prefieres hacernos llegar tu cariño desde donde estés, puedes escanear este código
            </p>

            <!-- QR en un marco blanco con esquinas doradas -->
            <div class="sr-qr-marco" id="qr-marco">
                <span class="sr-qr-esq sr-qr-esq-1"></span>
                <span class="sr-qr-esq sr-qr-esq-2"></span>
                <span class="sr-qr-esq sr-qr-esq-3"></span>
                <span class="sr-qr-esq sr-qr-esq-4"></span>
                <div class="sr-qr">
                    <img src={qr.imagen} alt="Código QR para regalo" class="w-full h-full" />
                    <span class="sr-qr-brillo" aria-hidden="true"></span>
                </div>
            </div>

            <!-- BOTÓN DESCARGAR QR: el invitado lo guarda y lo abre desde su app del banco -->
            <a
                href={qr.imagen}
                download="QR-regalo-Alain-y-Marisabel.png"
                class="sr-boton inline-flex items-center justify-center gap-2.5 mt-5 px-7 py-3 rounded-xl font-jane-light text-white text-sm uppercase tracking-[0.18em]"
                id="btn-descargar-qr"
            >
                <svg class="w-4 h-4 relative" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 4v11"></path>
                    <path d="M7 10l5 5 5-5"></path>
                    <path d="M5 20h14"></path>
                </svg>
                <span class="relative">Descargar QR</span>
            </a>
            <p class="font-mollen-light text-[#f3ead9]/60 text-xs italic mt-3">
                Guárdalo y ábrelo desde la app de tu banco
            </p>

            <p class="font-jane-light uppercase tracking-[0.18em] text-[#d9c07a] text-xs mt-5">
                {qr.banco}
            </p>
            <p class="font-mollen-light text-[#f3ead9]/90 text-sm mt-1">
                {qr.titular}
            </p>
            <p class="font-great-vibes-local text-[#e8d5a8] text-2xl leading-tight mt-4">
                ¡Gracias por tu cariño!
            </p>
        </div>

    </div>
</section>

<style>
    /* Ícono dentro de un aro dorado que se dibuja */
    .sr-icono {
        position: relative;
        width: 5.25rem;
        height: 5.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .sr-icono svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        transform: rotate(-90deg);
    }
    .sr-aro {
        stroke: #d9c07a;
        stroke-width: 1;
        stroke-dasharray: 1;
    }

    /* Tarjetas de vidrio con borde dorado fino */
    .sr-tarjeta {
        position: relative;
        padding: 2rem 1.25rem 1.5rem;
        border-radius: 18px;
        border: 1px solid rgba(217, 192, 122, 0.45);
        background: linear-gradient(
            160deg,
            rgba(255, 255, 255, 0.08),
            rgba(255, 255, 255, 0.02)
        );
        box-shadow:
            0 22px 40px -22px rgba(0, 0, 0, 0.7),
            0 0 24px -10px rgba(233, 196, 143, 0.3),
            inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }
    .sr-tarjeta::before {
        content: "";
        position: absolute;
        inset: 6px;
        border-radius: 13px;
        border: 1px solid rgba(217, 192, 122, 0.18);
        pointer-events: none;
    }

    /* Etiqueta que cuelga del borde superior */
    .sr-etiqueta {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translate(-50%, -50%);
        white-space: nowrap;
        padding: 0.3rem 1rem;
        border-radius: 9999px;
        font-size: 0.7rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #10263f;
        background: linear-gradient(180deg, #f3e2b5, #d9c07a);
        box-shadow: 0 4px 10px -3px rgba(0, 0, 0, 0.5);
    }

    /* Botón terracota en relieve, como el de la portada */
    .sr-boton {
        position: relative;
        overflow: hidden;
        background: linear-gradient(180deg, #ec9455 0%, #d4682a 55%, #bf5523 100%);
        border: 1px solid rgba(255, 226, 190, 0.45);
        box-shadow:
            0 4px 0 #8a3812,
            0 12px 20px -6px rgba(0, 0, 0, 0.55),
            inset 0 1px 0 rgba(255, 240, 220, 0.6);
        text-shadow: 0 1px 1px rgba(90, 35, 10, 0.5);
        transition:
            transform 0.15s ease,
            box-shadow 0.15s ease;
    }
    .sr-boton:hover {
        transform: translateY(-2px);
    }
    .sr-boton:active {
        transform: translateY(3px);
        box-shadow:
            0 1px 0 #8a3812,
            0 6px 12px -4px rgba(0, 0, 0, 0.5),
            inset 0 1px 0 rgba(255, 240, 220, 0.6);
    }
    .sr-boton::after {
        content: "";
        position: absolute;
        top: 0;
        left: -60%;
        width: 40%;
        height: 100%;
        background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.4), transparent);
        transform: skewX(-20deg);
        animation: sr-destello 4s ease-in-out 1.5s infinite;
    }
    @keyframes sr-destello {
        0% {
            left: -60%;
        }
        40%,
        100% {
            left: 130%;
        }
    }

    /* QR: marco blanco con esquinas doradas tipo visor */
    .sr-qr-marco {
        position: relative;
        width: 11rem;
        margin: 0 auto;
        padding: 0.7rem;
    }
    .sr-qr {
        position: relative;
        overflow: hidden;
        aspect-ratio: 1;
        padding: 0.7rem;
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 0 14px 26px -10px rgba(0, 0, 0, 0.7);
    }
    .sr-qr-esq {
        position: absolute;
        width: 1.4rem;
        height: 1.4rem;
        border-color: #d9c07a;
        border-style: solid;
        border-width: 0;
    }
    .sr-qr-esq-1 { top: 0; left: 0; border-top-width: 2px; border-left-width: 2px; border-top-left-radius: 10px; }
    .sr-qr-esq-2 { top: 0; right: 0; border-top-width: 2px; border-right-width: 2px; border-top-right-radius: 10px; }
    .sr-qr-esq-3 { bottom: 0; left: 0; border-bottom-width: 2px; border-left-width: 2px; border-bottom-left-radius: 10px; }
    .sr-qr-esq-4 { bottom: 0; right: 0; border-bottom-width: 2px; border-right-width: 2px; border-bottom-right-radius: 10px; }

    /* Línea de luz que recorre el QR, como un escáner suave */
    .sr-qr-brillo {
        position: absolute;
        left: 0;
        right: 0;
        top: -30%;
        height: 30%;
        background: linear-gradient(
            180deg,
            transparent,
            rgba(217, 192, 122, 0.28),
            transparent
        );
        animation: sr-escaner 3.5s ease-in-out infinite;
        pointer-events: none;
    }
    @keyframes sr-escaner {
        0% {
            top: -30%;
        }
        60%,
        100% {
            top: 100%;
        }
    }

    .sr-flor {
        transform-origin: 0% 50%;
        filter: drop-shadow(0 12px 16px rgba(0, 0, 0, 0.4));
    }

    @media (prefers-reduced-motion: reduce) {
        .sr-boton::after,
        .sr-qr-brillo {
            animation: none;
        }
    }
</style>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { animarEntradas, sinMovimiento } from "../scripts/entradas";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("seccion-regalos");
        if (!seccion) return;

        animarEntradas(seccion);

        // El aro del regalo se dibuja
        gsap.fromTo(
            "#img-regalo .sr-aro",
            { strokeDashoffset: 1 },
            {
                strokeDashoffset: 0,
                duration: 1.8,
                ease: "power2.inOut",
                scrollTrigger: {
                    trigger: "#img-regalo",
                    start: "top 90%",
                    toggleActions: "play none none reset",
                },
            },
        );

        // Las esquinas doradas del QR se cierran sobre el código
        gsap.fromTo(
            "#qr-marco .sr-qr-esq",
            { opacity: 0, scale: 1.6 },
            {
                opacity: 1,
                scale: 1,
                duration: 0.8,
                stagger: 0.08,
                ease: "back.out(2)",
                delay: 0.4,
                scrollTrigger: {
                    trigger: "#qr-marco",
                    start: "top 90%",
                    toggleActions: "play none none reset",
                },
            },
        );

        if (!sinMovimiento()) {
            gsap.to(".sr-pluma", {
                y: -5,
                rotation: 2,
                duration: 3,
                ease: "sine.inOut",
                yoyo: true,
                repeat: -1,
            });
            gsap.to("#costadito2-regalos", {
                rotation: 3,
                duration: 3.8,
                ease: "sine.inOut",
                yoyo: true,
                repeat: -1,
                delay: 1.2,
            });
        }
    });
</script>
